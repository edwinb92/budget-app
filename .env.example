# Supabase — copiá este archivo a .env y completá con tus valores reales.
# Los encontrás en: Supabase dashboard → Project Settings → API Keys
#
# El prefijo EXPO_PUBLIC_ hace que Expo inyecte estas variables en el bundle del cliente.
# La publishable key (sb_publishable_...) es pública por diseño — RLS protege los datos.
# NUNCA pongas la secret key (sb_secret_...) ni la JWT Signing Key acá.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
